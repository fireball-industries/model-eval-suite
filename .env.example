# Copy to .env (git-ignored) and fill in the keys you have.
# The harness reads provider keys from the environment; only the providers
# whose models you actually run need a key set.

# --- Model providers (the models under test) ---
ANTHROPIC_API_KEY=        # Claude models
OPENAI_API_KEY=           # OpenAI models
ZHIPUAI_API_KEY=          # GLM models (z.ai / Zhipu)
GEMINI_API_KEY=           # Google Gemini models

# --- Judge model (SycEval, Elephant, MultiChallenge use an LLM judge) ---
# Pin one judge and reuse it across runs for comparability. Defaults to the
# Anthropic key above unless a separate judge provider is configured.
JUDGE_API_KEY=

# --- Optional: ingest sources that require auth (most are public scrapes) ---
# HF_TOKEN=               # gated HuggingFace datasets (e.g. GAIA)
